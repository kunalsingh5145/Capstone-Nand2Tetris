// Memory.hdl - RAM16K (0-16383), Screen (16384-24575), Keyboard (24576)
CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux4Way(in=load, sel=address[13..14], a=r1, b=r2, c=scr, d=kb);
    Or(a=r1, b=r2, out=loadRam);
    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=scr, address=address[0..12], out=scrOut);
    Keyboard(out=kbdOut);
    Mux4Way16(a=ramOut, b=ramOut, c=scrOut, d=kbdOut,
              sel=address[13..14], out=out);
}
